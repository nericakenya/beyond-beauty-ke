# ── Server ──────────────────────────────────────────────
PORT=3000

# Your deployed URL (needed for Mpesa callback).
# For local testing use ngrok: https://xxxxxx.ngrok.io
# For production use your Render/Railway URL: https://your-app.onrender.com
BASE_URL=http://localhost:3000

# ── Admin ────────────────────────────────────────────────
# Random secret to protect the admin dashboard. Change this!
ADMIN_KEY=change-this-to-a-strong-secret

# ── Mpesa Daraja ─────────────────────────────────────────
# Get credentials from: https://developer.safaricom.co.ke
MPESA_ENV=sandbox

# Consumer Key and Secret from your Daraja app
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here

# Your M-Pesa Paybill or Till number
# Sandbox test shortcode: 174379
MPESA_SHORTCODE=174379

# Lipa Na Mpesa Online Passkey (from Daraja portal)
# Sandbox passkey: bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# CustomerPayBillOnline (Paybill) or CustomerBuyGoodsOnline (Till)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# ── WhatsApp ─────────────────────────────────────────────
WHATSAPP_NUMBER=254700000000

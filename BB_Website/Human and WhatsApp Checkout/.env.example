# ── Daraja credentials (from developer.safaricom.co.ke) ─────────────────────
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret

# "sandbox" or "production"
MPESA_ENV=sandbox

# Your Till Number (Buy Goods) or Paybill number
# Sandbox test shortcode: 174379
MPESA_SHORTCODE=174379

# Lipa Na M-Pesa passkey — from the Daraja portal under your app
# Sandbox passkey: bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Public HTTPS URL Safaricom will POST the payment result to
# During dev: use ngrok — e.g. https://xxxx.ngrok.io/api/mpesa/callback
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback

PORT=3000

# Joy — WhatsApp agent settings. Copy to .env for local runs (never commit .env);
# on Railway, add each of these under the service's Variables tab.

# ── Meta WhatsApp Cloud API (developers.facebook.com → your app → WhatsApp) ──
META_ACCESS_TOKEN=            # permanent System User token (Business Settings → System users)
META_PHONE_NUMBER_ID=         # "Phone number ID" on the API Setup page (test number for now)
META_APP_SECRET=              # App settings → Basic → App secret (used to check webhook signatures)
META_VERIFY_TOKEN=            # any long random string; type the same into the webhook form
META_GRAPH_VERSION=v25.0
RESTOCK_TEMPLATE_NAME=        # approved back-in-stock template, e.g. back_in_stock (blank until Meta approves it)
RESTOCK_TEMPLATE_LANG=en_US
PAYMENT_CHECK_MINUTES=3       # thank-you to the customer after you set an order's Payment Status to Paid (0 = off)
RESTOCK_CHECK_MINUTES=720     # how often to check stock for waiting restock requests: 720 = every 12 hours (0 = off)

# ── Email (Resend) — back-in-stock emails; leave blank to switch off ──
RESEND_API_KEY=
EMAIL_FROM=                   # e.g. Joy at Beyond Beauty <hello@beyondbeauty.co.ke> — domain must be verified in Resend
EMAIL_REPLY_TO=hello@beyondbeauty.co.ke

# ── Claude ──
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=medium          # low | medium | high

# ── Airtable (same base as the shop) ──
AIRTABLE_TOKEN=               # needs data.records:read + data.records:write on the base
AIRTABLE_BASE_ID=

# ── Shop ──
SHOP_URL=https://beyondbeauty.co.ke

# ── Team ──
ADMIN_WHATSAPP=               # your WhatsApp number, 2547XXXXXXXX: gets alerts and may send #status / #pause / #release
HUMAN_TAKEOVER_HOURS=12       # Joy stays quiet this long after the team replies from the app

# ── Local testing ──
DRY_RUN=0                     # 1 = print replies instead of sending them
PORT=3000
